--// AUTO RP Name + Bio + Red Fade (script chalte hi apne aap lagta hai)
task.spawn(function()
    local RP_NAME = "VÆLOR PROP HUB"
    local RP_BIO = "more than 40 props creation"

    local ok, RE = pcall(function()
        return game:GetService("ReplicatedStorage"):WaitForChild("RE", 10)
    end)
    if not ok or not RE then return end

    pcall(function()
        RE["1RPNam1eTex1t"]:FireServer("RolePlayName", RP_NAME)
        RE["1RPNam1eTex1t"]:FireServer("RolePlayBio", RP_BIO)
    end)

    local red = Color3.fromRGB(255, 0, 0)
    local dark = Color3.fromRGB(100, 0, 0)
    local t0 = tick()
    while true do
        -- red -> dark red -> red, loop
        local a = (1 - math.cos((tick() - t0) * 2)) / 2
        local color = red:Lerp(dark, a)
        pcall(function()
            RE["1RPNam1eColo1r"]:FireServer("PickingRPNameColor", color)
            RE["1RPNam1eColo1r"]:FireServer("PickingRPBioColor", color)
        end)
        task.wait(0.15)
    end
end)
