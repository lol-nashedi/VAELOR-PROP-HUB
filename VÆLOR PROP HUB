--// Helper: URL se script load karke chalata hai
local function RunScript(url)
    local ok, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    if not ok then
        warn("Script error: " .. tostring(err))
        Luna:Notification({
            Title = "Error",
            Icon = "error",
            ImageSource = "Material",
            Content = "Script load nahi hui, console check karo."
        })
    end
end

